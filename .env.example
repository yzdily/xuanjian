# ============================================================
# PentestAgent 配置
# 复制为 .env 并填写实际值
# ============================================================

# ---------- LLM 配置 ----------
# 支持 OpenAI 兼容协议 (DeepSeek/GLM/混元/Qwen/Kimi/MiniMax/...)
# 和 Anthropic 原生协议 (Claude)
# 可配 1~10 个 LLM，至少配一个，在 Web UI 右上角切换
#
# ⚠️ 重要：模型名必须使用厂商官方真实模型名，否则会 404/400。
#    DeepSeek 官方模型仅 deepseek-chat 与 deepseek-reasoner 两个。
#    注意：data/llm_configs.json 存在时，本文件 LLM 配置不生效。

# --- DeepSeek（推荐主模型）---
#LLM_1_PROVIDER=openai
#LLM_1_BASE_URL=https://api.deepseek.com/v1
#LLM_1_API_KEY=sk-your-deepseek-key
#LLM_1_MODEL=deepseek-chat

# --- DeepSeek Reasoner（推理模式，适合复杂分析）---
# LLM_2_PROVIDER=openai
# LLM_2_BASE_URL=https://api.deepseek.com/v1
# LLM_2_API_KEY=sk-your-deepseek-key
# LLM_2_MODEL=deepseek-reasoner

# --- GLM（智谱）---
# LLM_3_PROVIDER=openai
# LLM_3_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_3_API_KEY=your-glm-key
# LLM_3_MODEL=glm-5.1



# --- 混元（腾讯）---
# LLM_4_PROVIDER=openai
# LLM_4_BASE_URL=https://tokenhub.tencentmaas.com/v1
# LLM_4_API_KEY=your-hunyuan-key
# LLM_4_MODEL=hy3-preview

# --- Claude（Anthropic 原生协议）---
# LLM_5_PROVIDER=anthropic
# LLM_5_BASE_URL=https://api.anthropic.com
# LLM_5_API_KEY=sk-ant-xxx
# LLM_5_MODEL=claude-sonnet-4-20250514

# --- Qwen（通义千问，OpenAI 兼容协议）---
# LLM_6_PROVIDER=openai
# LLM_6_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_6_API_KEY=sk-your-qwen-key
# LLM_6_MODEL=qwen-max

# 其他 OpenAI 兼容模型同理，改 BASE_URL/MODEL 即可：
# Kimi: https://api.moonshot.cn/v1
# MiniMax: https://api.minimax.chat/v1

# ---------- 代理抓包 ----------
PROXY_PORT=18080
PROXY_WEB_PORT=18081

# ---------- 浏览器 ----------
BROWSER_HEADLESS=false
BROWSER_PROXY=http://127.0.0.1:18080

# ---------- Agent 调度 ----------
CONTEXT_COMPRESS_THRESHOLD=20

# ---------- 知识库 ----------
KNOWLEDGE_BASE_PATH=./knowledge/AboutSecurity
SKILLS_MY_PATH=./skills_my
PLAYBOOKS_PATH=./playbooks

# ---------- 笔记与报告 ----------
NOTE_PATH=./data/notes
REPORT_PATH=./data/reports
TASK_PATH=./data/tasks

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_DIR=./data/logs

# ---------- 外部脚本扫描器（可选）----------
# 启用后，Phase 2 会并行运行外部脚本扫描器，补齐 FastScanner 未覆盖的漏洞类型。
# 前置条件：git clone https://github.com/yzdily/api-pentest-extension external/api-pentest-extension
# 认证信息（token/cookies）由玄鉴自动从 session_info 注入为环境变量 PENTEST_TOKEN / PENTEST_COOKIES。
#
# 方式 1：全量扫描（运行全部 51 个脚本）
#XUANJIAN_SCRIPTED_SCAN_CMD=python external/api_pentest_wrapper.py --api-file {api_file} --output {output_file}
#
# 方式 2：仅 dirsearch 目录爆破（方案 A 适配版，只运行 dirsearch_scanner.py）
# 适用于目标不可达时的被动侦察，或需要快速目录扫描的场景。
# 默认指向 D:\qianwencode\api-pentest-extension\skills，可通过 PENTEST_SKILLS_DIR 环境变量覆盖。
#XUANJIAN_SCRIPTED_SCAN_CMD=python external/dirsearch_only_wrapper.py --api-file {api_file} --output {output_file}
#
# dirsearch 专用参数（环境变量）：
#   DIRSEARCH_THREADS=15           — 并发线程数
#   DIRSEARCH_RECURSIVE=1          — 启用递归扫描
#   DIRSEARCH_MAX_DEPTH=2          — 递归深度
#   DIRSEARCH_EXTENSIONS=php,bak   — 文件扩展名
#   DIRSEARCH_WORDLIST=/path/to/wl — 外部字典文件
#   DIRSEARCH_TIMEOUT=10           — 单请求超时秒数
#   PENTEST_SKILLS_DIR=...         — skills 目录路径
#
#XUANJIAN_SCRIPTED_SCAN_TIMEOUT=300
